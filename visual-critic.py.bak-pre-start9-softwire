#!/usr/bin/env python3
"""Dobby — harsh visual critic for the Gravity Lander game.

Uses Ollama moondream (tiny local vision) to judge a screenshot. Tries moondream
first (safe RAM fit); falls back to qwen3-vl:32b if available and unloaded check.
Prints the critic's verdict to stdout.

Usage: python3 visual-critic.py <image.png>
"""
import base64, json, sys, time, urllib.request

OLLAMA = "http://127.0.0.1:11434"

CRITIQUE = (
    "You are Dobby, an extremely harsh senior AAA game art director. "
    "You judge a Lunar-Lander-style ThreeJS game screenshot with brutal honesty. "
    "Compare it mentally to a polished commercial game like Lunar Lander / a AAA title.\n\n"
    "Rate 0-10 on: (1) overall visual beauty, (2) terrain/lighting detail, "
    "(3) spacecraft/prop quality, (4) HUD/UI polish, (5) atmosphere/cohesion.\n\n"
    "Then give a VERDICT on the LAST line, exactly one of:\n"
    "PASS_AAA — genuinely wowed, on par with or better than a polished commercial game, or\n"
    "NEEDS_WORK — anything less. NO soft grading: AAA or it fails.\n"
    "Be specific about what looks cheap, empty, low-poly, or unfinished."
)


def call_ollama(model, image_b64):
    payload = {
        "model": model, "stream": False,
        "options": {"temperature": 0.3},
        "messages": [{"role": "user", "content": CRITIQUE, "images": [image_b64]}],
    }
    req = urllib.request.Request(
        OLLAMA + "/api/chat", data=json.dumps(payload).encode(),
        headers={"Content-Type": "application/json"})
    t = time.time()
    with urllib.request.urlopen(req, timeout=420) as r:
        d = json.loads(r.read().decode())
    print(f"[{model}] elapsed {round(time.time()-t)}s", file=sys.stderr)
    msg = d.get("message", {}).get("content", "").strip()
    err = d.get("error")
    if err:
        return f"[model error] {err}", False
    return msg, True


def main():
    if len(sys.argv) < 2:
        print("usage: visual-critic.py <image.png>", file=sys.stderr)
        sys.exit(2)
    img = base64.b64encode(open(sys.argv[1], "rb").read()).decode()
    # Try moondream (small, safe fit) first.
    try:
        text, ok = call_ollama("moondream", img)
        if ok and text and text.lower() not in ("", "no content"):
            print(text)
            return
        print("[moondream empty, falling back]", file=sys.stderr)
    except Exception as e:
        print(f"[moondream failed: {e!r}]", file=sys.stderr)
    # Fallback: qwen3-vl:32b (may OOM on a loaded box, so best-effort).
    try:
        text, ok = call_ollama("qwen3-vl:32b", img)
        if ok:
            print(text)
    except Exception as e:
        print(f"[qwen3-vl failed: {e!r}]", file=sys.stderr)
        sys.exit(1)


if __name__ == "__main__":
    main()
